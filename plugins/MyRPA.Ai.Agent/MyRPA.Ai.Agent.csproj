<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The AI Agent activity and its runtime (ADR-0048): a bounded loop between a model (IAiProvider, MyRPA.Ai.Contracts)
    and authorized tools (project workflows, MCP server tools, safe built-ins). A plugin: it references the Automation
    SDK and the AI contracts (host-provided, Private=false / ExcludeAssets=runtime) and owns the MCP client SDK
    (ModelContextProtocol.Core), which no other project may reference.
  -->
  <PropertyGroup>
    <RootNamespace>MyRPA.Ai.Agent</RootNamespace>
    <Description>MyRPA AI Agent activity: bounded agent runtime, tool registry, MCP client.</Description>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MyRPA.Sdk\MyRPA.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\src\MyRPA.Ai.Contracts\MyRPA.Ai.Contracts.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Include="myrpa-plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- MyRPA.Core and MyRPA.Workflow arrive transitively through MyRPA.Sdk; they and the AI contracts are host-provided. -->
  <Target Name="ExcludeHostContractAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'MyRPA.Core' or '%(Filename)' == 'MyRPA.Workflow' or '%(Filename)' == 'MyRPA.Ai.Contracts'" />
    </ItemGroup>
  </Target>
</Project>

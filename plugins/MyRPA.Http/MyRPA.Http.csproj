<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HTTP/REST activity (Phase 7, ADR-0042). A plugin: it references only the Automation SDK (host-provided, so
    Private=false / ExcludeAssets=runtime) and no packages; HTTP comes from the BCL. HttpClient is banned in src
    (ADR-0008), so network access lives here, in a plugin the operator chooses to load. The build output directory is
    a complete plugin directory.
  -->
  <PropertyGroup>
    <RootNamespace>MyRPA.Http</RootNamespace>
    <Description>MyRPA HTTP/REST activity.</Description>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MyRPA.Sdk\MyRPA.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Include="myrpa-plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- MyRPA.Core and MyRPA.Workflow arrive transitively through MyRPA.Sdk; they are host-provided contract assemblies. -->
  <Target Name="ExcludeHostContractAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'MyRPA.Core' or '%(Filename)' == 'MyRPA.Workflow'" />
    </ItemGroup>
  </Target>
</Project>

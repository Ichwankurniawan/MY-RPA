<Project>
  <!-- Central package management. Keep this list minimal; every addition needs a reason (see CLAUDE.md). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Runtime abstractions (libraries)">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Plugins only (never src; enforced by MyRPA.Architecture.Tests)">
    <!-- ADR-0017: the browser provider plugin. Browsers: Chromium 153.0.8010.12 (Playwright revision 1243). -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <!-- ADR-0042: the Excel plugin reads and writes .xlsx without Excel (MIT, Microsoft). -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- ADR-0043: the documents plugin reads PDF text (PdfPig by UglyToad, Apache-2.0, no dependencies on net8+). -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <!-- ADR-0043: the email plugin speaks SMTP and IMAP (MailKit and its MimeKit, MIT, Jeffrey Stedfast; Microsoft recommends MailKit over System.Net.Mail). -->
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <!-- ADR-0043: the database plugin (SQLite and SQL Server: MIT, Microsoft; PostgreSQL: Npgsql, PostgreSQL licence). -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- ADR-0043: the SFTP plugin (SSH.NET, MIT, with BouncyCastle). -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
  <ItemGroup Label="Composition roots only">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Tests only">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <!-- FakeTimeProvider: deterministic Delay/timeout tests without Thread.Sleep. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>

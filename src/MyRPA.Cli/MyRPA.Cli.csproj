<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Composition root: the only Phase 1 project allowed to reference Microsoft.Extensions.Hosting
    and to know the full project graph (ADR-0003, ADR-0005).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MyRPA.Cli</RootNamespace>
    <AssemblyName>myrpa</AssemblyName>
    <Description>MyRPA command-line interface.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyRPA.Core\MyRPA.Core.csproj" />
    <ProjectReference Include="..\MyRPA.Workflow\MyRPA.Workflow.csproj" />
    <ProjectReference Include="..\MyRPA.Activities\MyRPA.Activities.csproj" />
    <ProjectReference Include="..\MyRPA.Runtime\MyRPA.Runtime.csproj" />
    <ProjectReference Include="..\MyRPA.Storage\MyRPA.Storage.csproj" />
    <ProjectReference Include="..\MyRPA.Sdk\MyRPA.Sdk.csproj" />
    <ProjectReference Include="..\MyRPA.Plugins\MyRPA.Plugins.csproj" />
    <!-- ADR-0039: the browser plugin's extension contracts are host-provided; without them it cannot register here. -->
    <ProjectReference Include="..\MyRPA.Browser.Contracts\MyRPA.Browser.Contracts.csproj" />
    <!-- ADR-0048: the host shares the AI contracts with AI provider and agent plugins, so AI.Agent runs from the CLI too. -->
    <ProjectReference Include="..\MyRPA.Ai.Contracts\MyRPA.Ai.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>

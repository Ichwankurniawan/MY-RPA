<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    MyRPA.Server (ADR-0022): the control plane. Composition root; the only src project allowed to use ASP.NET Core.
    Local mode (ADR-0025): loopback only, projects, catalog, validation, runs and multiplexed SSE (ADR-0024).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MyRPA.Server</RootNamespace>
    <AssemblyName>MyRPA.Server</AssemblyName>
    <Description>MyRPA control-plane server (local mode).</Description>
    <!-- The Web SDK runs `dotnet run` in the project folder; relative project, plugin and open paths must resolve from
         where the command was typed, as for the CLI. -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyRPA.Core\MyRPA.Core.csproj" />
    <ProjectReference Include="..\MyRPA.Workflow\MyRPA.Workflow.csproj" />
    <ProjectReference Include="..\MyRPA.Activities\MyRPA.Activities.csproj" />
    <ProjectReference Include="..\MyRPA.Runtime\MyRPA.Runtime.csproj" />
    <ProjectReference Include="..\MyRPA.Storage\MyRPA.Storage.csproj" />
    <ProjectReference Include="..\MyRPA.Plugins\MyRPA.Plugins.csproj" />
    <ProjectReference Include="..\MyRPA.Contracts\MyRPA.Contracts.csproj" />
    <ProjectReference Include="..\MyRPA.Browser.Contracts\MyRPA.Browser.Contracts.csproj" />
    <ProjectReference Include="..\MyRPA.Execution.Hosting\MyRPA.Execution.Hosting.csproj" />
  </ItemGroup>
  <!--
    W6 (ADR-0031): the built Web Studio (web/studio/dist, from 'npm run build') is copied next to the server as wwwroot,
    its default web root, so 'MyRPA.Server -project <dir>' serves the Studio with no -web. The .NET build never runs
    npm: without a built dist nothing is copied and the server starts without a UI (and says so).
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\web\studio\dist\index.html')">
    <None Include="$(MSBuildThisFileDirectory)..\..\web\studio\dist\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MyRPA.Server.Tests" />
    <InternalsVisibleTo Include="MyRPA.Architecture.Tests" />
  </ItemGroup>
</Project>

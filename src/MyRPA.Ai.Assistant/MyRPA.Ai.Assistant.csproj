<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The AI Workflow Assistant (ADR-0047): turns requests into proposals in the existing workflow format, checks every
    proposal with the existing validator and the catalog policy, repairs within bounds, explains workflows and failed
    runs. No HTTP and no vendor code: models are reached only through IAiProvider (MyRPA.Ai.Contracts).
  -->
  <PropertyGroup>
    <RootNamespace>MyRPA.Ai.Assistant</RootNamespace>
    <Description>MyRPA AI Workflow Assistant: proposal pipeline, validation, repair, explanation.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyRPA.Core\MyRPA.Core.csproj" />
    <ProjectReference Include="..\MyRPA.Workflow\MyRPA.Workflow.csproj" />
    <ProjectReference Include="..\MyRPA.Ai.Contracts\MyRPA.Ai.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MyRPA.Ai.Assistant.Tests" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MyRPA Runner (Phase 10, ADR-0049): the execution worker. A composition root that composes the same engine, built-in
    activities and plugin host as the CLI, connects to the Server (outbound only), claims jobs under leases, verifies each
    package and executes it with ExecutionHost. Runs in a console or as a Windows service. Only RunnerConnection may make
    HTTP calls (ArchitectureRules.BannedApiExemptions).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MyRPA.Runner</RootNamespace>
    <AssemblyName>myrpa-runner</AssemblyName>
    <Description>MyRPA Runner: executes jobs assigned by the MyRPA Server.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyRPA.Core\MyRPA.Core.csproj" />
    <ProjectReference Include="..\MyRPA.Workflow\MyRPA.Workflow.csproj" />
    <ProjectReference Include="..\MyRPA.Activities\MyRPA.Activities.csproj" />
    <ProjectReference Include="..\MyRPA.Runtime\MyRPA.Runtime.csproj" />
    <ProjectReference Include="..\MyRPA.Storage\MyRPA.Storage.csproj" />
    <ProjectReference Include="..\MyRPA.Sdk\MyRPA.Sdk.csproj" />
    <ProjectReference Include="..\MyRPA.Plugins\MyRPA.Plugins.csproj" />
    <ProjectReference Include="..\MyRPA.Contracts\MyRPA.Contracts.csproj" />
    <ProjectReference Include="..\MyRPA.Execution.Hosting\MyRPA.Execution.Hosting.csproj" />
    <ProjectReference Include="..\MyRPA.Orchestration\MyRPA.Orchestration.csproj" />
    <!-- Host-provided extension contracts (ADR-0039, ADR-0048): browser and AI plugins register against them. -->
    <ProjectReference Include="..\MyRPA.Browser.Contracts\MyRPA.Browser.Contracts.csproj" />
    <ProjectReference Include="..\MyRPA.Ai.Contracts\MyRPA.Ai.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MyRPA.Runner.Tests" />
    <InternalsVisibleTo Include="MyRPA.Architecture.Tests" />
  </ItemGroup>
</Project>

    May reference MyRPA.Core and MyRPA.Workflow only; NOT MyRPA.Activities (ADR-0003).
    Packages: Microsoft.Extensions.*.Abstractions only.
  -->
  <PropertyGroup>
    <RootNamespace>MyRPA.Runtime</RootNamespace>
    <Description>MyRPA runtime composition, execution scopes, logging and tracing foundation.</Description>

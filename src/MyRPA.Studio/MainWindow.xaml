<Window x:Class="MyRPA.Studio.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyRPA.Studio.ViewModels;assembly=MyRPA.Studio.Core"
        xmlns:ds="clr-namespace:MyRPA.Studio.Designer"
        Title="{Binding Title}"
        Width="1280" Height="820" MinWidth="900" MinHeight="560"
        FontFamily="Segoe UI" FontSize="12.5"
        Background="{DynamicResource WindowBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Designer/StudioTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+X" Command="{Binding CutCommand}" />
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
        <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
        <KeyBinding Gesture="Shift+F5" Command="{Binding StopCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="5" />
            <RowDefinition Height="230" MinHeight="90" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu and run toolbar -->
        <DockPanel Grid.Row="0" Background="{StaticResource ChromeBrush}" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,3,8,3">
                <Button Style="{StaticResource RunButton}" Command="{Binding RunCommand}" ToolTip="Run the workflow (F5)" AutomationProperties.Name="Run">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M0,0 L9,5.5 L0,11 Z" Fill="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Run" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource StopButton}" Command="{Binding StopCommand}" ToolTip="Stop the run (Shift+F5)" AutomationProperties.Name="Stop" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="9" Height="9" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Menu Background="Transparent" VerticalAlignment="Center" Padding="2">
                <MenuItem Header="_File">
                    <MenuItem Header="_New" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                    <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                    <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                    <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                    <Separator />
                    <MenuItem Header="E_xit" Click="OnExitClick" />
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="{Binding UndoText}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                    <MenuItem Header="{Binding RedoText}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                    <Separator />
                    <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                    <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                    <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                    <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" InputGestureText="Del" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="_Workflow properties" Command="{Binding SelectWorkflowCommand}" />
                    <MenuItem Header="_Errors" Click="OnShowErrorsClick" />
                    <MenuItem Header="_Logs" Click="OnShowLogsClick" />
                </MenuItem>
                <MenuItem Header="_Debug">
                    <MenuItem Header="_Run" Command="{Binding RunCommand}" InputGestureText="F5" />
                    <MenuItem Header="_Stop" Command="{Binding StopCommand}" InputGestureText="Shift+F5" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="150" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="320" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Activities (toolbox) -->
            <DockPanel Grid.Column="0" Background="{StaticResource PanelBrush}">
                <TextBlock DockPanel.Dock="Top" Text="Activities" Style="{StaticResource PaneTitle}" />
                <Grid DockPanel.Dock="Top" Margin="8,0,8,6">
                    <TextBox x:Name="SearchBox" Text="{Binding Toolbox.SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search activities" Padding="4,3" />
                    <TextBlock Text="Search…" IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}" Margin="8,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Toolbox.Categories}" Margin="4,0,4,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ToolboxCategoryViewModel}">
                                <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,2" FontWeight="SemiBold">
                                    <ItemsControl ItemsSource="{Binding Items}" FontWeight="Normal" Margin="6,2,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ToolboxItemViewModel}">
                                                <Border Style="{StaticResource ToolboxItem}" ToolTip="{Binding ToolTip}"
                                                        ds:DesignerBehaviors.DragPayload="{Binding Payload}"
                                                        AutomationProperties.Name="{Binding DisplayName}">
                                                    <Border.InputBindings>
                                                        <MouseBinding Gesture="LeftDoubleClick"
                                                                      Command="{Binding DataContext.AddActivityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding TypeName}" />
                                                    </Border.InputBindings>
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource SplitterBrush}" />

            <!-- Workflow designer -->
            <DockPanel Grid.Column="2" Background="{StaticResource CanvasBrush}">
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource SplitterBrush}" BorderThickness="0,0,0,1">
                    <DockPanel Margin="10,6">
                        <TextBlock DockPanel.Dock="Right" Text="Drag activities from the left • click to select • drag blocks to move" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DocumentName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="DesignerSurface" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Background="Transparent" MouseLeftButtonDown="OnDesignerBackgroundClick" Focusable="False">
                    <ContentControl Content="{Binding Root}" Margin="24,20,24,40" HorizontalAlignment="Left" MinWidth="420" Focusable="False" />
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{StaticResource SplitterBrush}" />

            <!-- Properties -->
            <DockPanel Grid.Column="4" Background="{StaticResource PanelBrush}">
                <TextBlock DockPanel.Dock="Top" Text="Properties" Style="{StaticResource PaneTitle}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,0,10,12" DataContext="{Binding Properties}">
                        <!-- The workflow itself -->
                        <StackPanel Visibility="{Binding IsWorkflow, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Workflow" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Id" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding WorkflowId, UpdateSourceTrigger=PropertyChanged}" ds:Commit.Command="{Binding CommitWorkflowInfoCommand}" AutomationProperties.Name="Workflow id" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding WorkflowName, UpdateSourceTrigger=PropertyChanged}" ds:Commit.Command="{Binding CommitWorkflowInfoCommand}" AutomationProperties.Name="Workflow name" />
                            <TextBlock Text="Version" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding WorkflowVersion, UpdateSourceTrigger=PropertyChanged}" ds:Commit.Command="{Binding CommitWorkflowInfoCommand}" AutomationProperties.Name="Workflow version" />
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding WorkflowDescription, UpdateSourceTrigger=PropertyChanged}" ds:Commit.Command="{Binding CommitWorkflowInfoCommand}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" AutomationProperties.Name="Workflow description" />
                            <TextBlock Text="{Binding WorkflowErrorText}" Style="{StaticResource ErrorText}" />
                            <TextBlock Text="Select a block in the designer to edit its properties." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                        </StackPanel>

                        <!-- The selected block -->
                        <StackPanel Visibility="{Binding IsNode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding TypeName}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding TypeDescription}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="Id" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding NodeId, UpdateSourceTrigger=PropertyChanged}" ds:Commit.Command="{Binding CommitNodeHeaderCommand}" AutomationProperties.Name="Activity id" />
                            <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding NodeDisplayName, UpdateSourceTrigger=PropertyChanged}" ds:Commit.Command="{Binding CommitNodeHeaderCommand}" AutomationProperties.Name="Display name" />
                            <TextBlock Text="{Binding NodeErrorText}" Style="{StaticResource ErrorText}" />
                            <ItemsControl ItemsSource="{Binding Editors}" Margin="0,6,0,0" Focusable="False" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource SplitterBrush}" />

        <!-- Variables | Arguments | Output | Logs | Errors -->
        <TabControl x:Name="BottomTabs" Grid.Row="3" BorderThickness="0,1,0,0" Padding="0" Background="{StaticResource PanelBrush}">
            <TabItem Header="Variables">
                <DockPanel Margin="8,6">
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Content="+ Add variable" Command="{Binding Variables.AddCommand}" Style="{StaticResource LinkButton}" />
                    <Grid DockPanel.Dock="Top" Style="{StaticResource GridHeader}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" /><TextBlock Grid.Column="1" Text="Type" /><TextBlock Grid.Column="2" Text="Default (JSON)" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Variables.Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:VariableRowViewModel}">
                                    <StackPanel Margin="0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ds:Commit.Command="{Binding CommitCommand}" Margin="0,0,4,0" AutomationProperties.Name="Variable name" />
                                            <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:DataChoices.Types}" SelectedItem="{Binding Type}" Margin="0,0,4,0" AutomationProperties.Name="Variable type" />
                                            <TextBox Grid.Column="2" Text="{Binding DefaultJson, UpdateSourceTrigger=PropertyChanged}" ds:Commit.Command="{Binding CommitCommand}" FontFamily="Consolas" AutomationProperties.Name="Variable default" />
                                            <Button Grid.Column="3" Content="✕" Style="{StaticResource IconButton}" ToolTip="Remove variable"
                                                    Command="{Binding DataContext.Variables.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </Grid>
                                        <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="Arguments">
                <DockPanel Margin="8,6">
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Content="+ Add argument" Command="{Binding Arguments.AddCommand}" Style="{StaticResource LinkButton}" />
                    <Grid DockPanel.Dock="Top" Style="{StaticResource GridHeader}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" /><ColumnDefinition Width="90" /><ColumnDefinition Width="120" /><ColumnDefinition Width="75" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" /><TextBlock Grid.Column="1" Text="Direction" /><TextBlock Grid.Column="2" Text="Type" />
                        <TextBlock Grid.Column="3" Text="Required" /><TextBlock Grid.Column="4" Text="Default (JSON)" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Arguments.Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ArgumentRowViewModel}">
                                    <StackPanel Margin="0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" /><ColumnDefinition Width="90" /><ColumnDefinition Width="120" /><ColumnDefinition Width="75" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ds:Commit.Command="{Binding CommitCommand}" Margin="0,0,4,0" AutomationProperties.Name="Argument name" />
                                            <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:DataChoices.Directions}" SelectedItem="{Binding Direction}" Margin="0,0,4,0" AutomationProperties.Name="Argument direction" />
                                            <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:DataChoices.Types}" SelectedItem="{Binding Type}" Margin="0,0,4,0" AutomationProperties.Name="Argument type" />
                                            <CheckBox Grid.Column="3" IsChecked="{Binding Required}" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="Argument required" />
                                            <TextBox Grid.Column="4" Text="{Binding DefaultJson, UpdateSourceTrigger=PropertyChanged}" ds:Commit.Command="{Binding CommitCommand}" FontFamily="Consolas" AutomationProperties.Name="Argument default" />
                                            <Button Grid.Column="5" Content="✕" Style="{StaticResource IconButton}" ToolTip="Remove argument"
                                                    Command="{Binding DataContext.Arguments.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </Grid>
                                        <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="OutputTab" Header="Output">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8" DataContext="{Binding Output}">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Status}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,2,0,6">
                            <Run Text="{Binding Duration, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ExecutionId, Mode=OneWay}" />
                        </TextBlock>
                        <TextBox Text="{Binding ErrorText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" BorderThickness="0" Background="Transparent" />
                        <TextBox Text="{Binding OutputsText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" BorderThickness="0" Background="Transparent" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="LogsTab" Header="Logs">
                <DockPanel>
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="Clear" Command="{Binding Log.ClearCommand}" Style="{StaticResource LinkButton}" Margin="0,2,10,2" />
                    <ListView ItemsSource="{Binding Log.Entries}" BorderThickness="0" FontFamily="Consolas">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Time" Width="95" DisplayMemberBinding="{Binding Time}" />
                                <GridViewColumn Header="Level" Width="85" DisplayMemberBinding="{Binding Level}" />
                                <GridViewColumn Header="Node" Width="120" DisplayMemberBinding="{Binding Node}" />
                                <GridViewColumn Header="Message" Width="700" DisplayMemberBinding="{Binding Message}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="ErrorsTab">
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="Errors" /><Run Text=" (" /><Run Text="{Binding Errors.Count, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </TabItem.Header>
                <ListView x:Name="ErrorList" ItemsSource="{Binding Errors}" BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="MouseDoubleClick" Handler="OnErrorDoubleClick" />
                            <EventSetter Event="KeyDown" Handler="OnErrorKeyDown" />
                            <Setter Property="ToolTip" Value="Double-click to select the block" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Severity" Width="75" DisplayMemberBinding="{Binding Severity}" />
                            <GridViewColumn Header="Code" Width="90" DisplayMemberBinding="{Binding Code}" />
                            <GridViewColumn Header="Location" Width="170" DisplayMemberBinding="{Binding Location}" />
                            <GridViewColumn Header="Message" Width="700" DisplayMemberBinding="{Binding Message}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="4" Background="{StaticResource ChromeBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Running…" FontWeight="SemiBold" Foreground="{StaticResource RunningBrush}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource MutedBrush}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

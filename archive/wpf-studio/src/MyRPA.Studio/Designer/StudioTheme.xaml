<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:MyRPA.Studio.ViewModels;assembly=MyRPA.Studio.Core"
                    xmlns:ds="clr-namespace:MyRPA.Studio.Designer">

    <!-- Palette -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#E9EBEF" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FAFAFB" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#EEF1F5" />
    <SolidColorBrush x:Key="SplitterBrush" Color="#D6D9DF" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#C9CED6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DBE7FF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EAF6EC" />
    <SolidColorBrush x:Key="RunningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="RunningSoftBrush" Color="#FFF4DD" />
    <SolidColorBrush x:Key="SlotBrush" Color="#F6F7F9" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Text styles -->
    <Style x:Key="PaneTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="10,8,10,6" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,4,0,2" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,2" />
        <Setter Property="Foreground" Value="#374151" />
    </Style>
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="GridHeader" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RunButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
    </Style>
    <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="2">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="ToolboxItem" TargetType="Border">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Designer: an activity block -->
    <DataTemplate DataType="{x:Type vm:NodeViewModel}">
        <Border x:Name="Card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="5" Padding="10,7,10,8" Margin="0,2" MinWidth="260" Focusable="True"
                ds:DesignerBehaviors.Selects="{Binding}" ds:DesignerBehaviors.DragPayload="{Binding Payload}"
                AutomationProperties.Name="{Binding Title}">
            <StackPanel>
                <DockPanel>
                    <Border x:Name="StateBadge" DockPanel.Dock="Right" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock x:Name="StateText" FontSize="11" Foreground="White" />
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TypeName}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock x:Name="Summary" Text="{Binding Summary}" FontFamily="Consolas" Foreground="#374151" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" />
                <ItemsControl ItemsSource="{Binding Items}" Margin="10,4,0,0" Focusable="False"
                              Visibility="{Binding HasList, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Slots}" Margin="0,4,0,0" Focusable="False"
                              Visibility="{Binding HasSlots, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Summary}" Value="">
                <Setter TargetName="Summary" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKnown}" Value="False">
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasErrors}" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RunState}" Value="{x:Static vm:NodeRunState.Running}">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource RunningSoftBrush}" />
                <Setter TargetName="StateBadge" Property="Visibility" Value="Visible" />
                <Setter TargetName="StateBadge" Property="Background" Value="{StaticResource RunningBrush}" />
                <Setter TargetName="StateText" Property="Text" Value="running" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RunState}" Value="{x:Static vm:NodeRunState.Completed}">
                <Setter TargetName="StateBadge" Property="Visibility" Value="Visible" />
                <Setter TargetName="StateBadge" Property="Background" Value="{StaticResource SuccessBrush}" />
                <Setter TargetName="StateText" Property="Text" Value="✓" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RunState}" Value="{x:Static vm:NodeRunState.Failed}">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource ErrorSoftBrush}" />
                <Setter TargetName="StateBadge" Property="Visibility" Value="Visible" />
                <Setter TargetName="StateBadge" Property="Background" Value="{StaticResource ErrorBrush}" />
                <Setter TargetName="StateText" Property="Text" Value="failed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                <Setter TargetName="Card" Property="Padding" Value="9,6,9,7" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Designer: a named slot (then/else/try/case:…) with its block or an empty drop zone -->
    <DataTemplate DataType="{x:Type vm:SlotViewModel}">
        <Border Background="{StaticResource SlotBrush}" CornerRadius="4" Padding="8,4,8,6" Margin="0,3,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                <ContentControl Content="{Binding Node}" Focusable="False" />
                <ContentControl Content="{Binding EmptyZone}" Focusable="False" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Designer: where a block can be dropped -->
    <DataTemplate DataType="{x:Type vm:DropZoneViewModel}">
        <Border x:Name="Zone" Background="Transparent" MinHeight="9" CornerRadius="3" ds:DesignerBehaviors.DropZone="{Binding}">
            <TextBlock x:Name="Hint" Text="{Binding Hint}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasHint}" Value="True">
                <Setter TargetName="Zone" Property="MinHeight" Value="30" />
                <Setter TargetName="Zone" Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter TargetName="Zone" Property="BorderThickness" Value="1" />
                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Zone" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter TargetName="Zone" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Zone" Property="BorderThickness" Value="1" />
                <Setter TargetName="Zone" Property="MinHeight" Value="24" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Properties: one editor per property, shaped by its kind -->
    <DataTemplate DataType="{x:Type vm:PropertyEditorViewModel}">
        <StackPanel Margin="0,6,0,4" ToolTip="{Binding Description}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding KindLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" />
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
            </DockPanel>
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ds:Commit.Command="{Binding CommitCommand}" FontFamily="Consolas" Margin="0,2,0,0"
                     Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Name}" />
            <ComboBox IsEditable="True" ItemsSource="{Binding Options}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ds:Commit.Command="{Binding CommitCommand}"
                      FontFamily="Consolas" Margin="0,2,0,0" Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Name}" />
            <StackPanel Visibility="{Binding IsMap, Converter={StaticResource BoolToVisibility}}" Margin="0,2,0,0">
                <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MapEntryViewModel}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" ds:Commit.Command="{Binding CommitCommand}" AutomationProperties.Name="Key" />
                                <TextBlock Grid.Column="1" Text="=" Margin="4,0" VerticalAlignment="Center" />
                                <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ds:Commit.Command="{Binding CommitCommand}" FontFamily="Consolas" AutomationProperties.Name="Value" />
                                <Button Grid.Column="3" Content="✕" Style="{StaticResource IconButton}" ToolTip="Remove"
                                        Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+ Add entry" Command="{Binding AddEntryCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" />
            </StackPanel>
            <TextBlock Text="{Binding HintText}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>

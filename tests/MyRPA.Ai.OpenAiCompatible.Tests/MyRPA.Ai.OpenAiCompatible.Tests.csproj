<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The OpenAI-compatible AI provider plugin (ADR-0047). The plugin is built first but never compiled against
    (ReferenceOutputAssembly=false): tests load it through the real plugin host. Every request goes to a local test
    endpoint on localhost; no real AI service or key is used.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\MyRPA.Plugins\MyRPA.Plugins.csproj" />
    <ProjectReference Include="..\..\src\MyRPA.Runtime\MyRPA.Runtime.csproj" />
    <ProjectReference Include="..\..\src\MyRPA.Ai.Contracts\MyRPA.Ai.Contracts.csproj" />
    <ProjectReference Include="..\..\plugins\MyRPA.Ai.OpenAiCompatible\MyRPA.Ai.OpenAiCompatible.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OpenAiPluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Ai.OpenAiCompatible\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

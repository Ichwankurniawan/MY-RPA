<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Database plugin tests (ADR-0043). The plugin is built first but never compiled against (ReferenceOutputAssembly=false):
    tests load it through the real plugin host, like the CLI. The drivers belong to the plugin only. SQLite always runs;
    SQL Server and PostgreSQL run against real servers when MYRPA_TEST_SQLSERVER or MYRPA_TEST_POSTGRES is set.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\MyRPA.Plugins\MyRPA.Plugins.csproj" />
    <ProjectReference Include="..\..\src\MyRPA.Runtime\MyRPA.Runtime.csproj" />
    <ProjectReference Include="..\..\plugins\MyRPA.Database\MyRPA.Database.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DatabasePluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Database\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

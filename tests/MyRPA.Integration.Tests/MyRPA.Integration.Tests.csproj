<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\MyRPA.Cli\MyRPA.Cli.csproj" />
    <!-- Built first, never compiled against: the CLI loads it with the plugin option like a user would. -->
    <ProjectReference Include="..\..\samples\plugins\MyRPA.Samples.DemoPlugin\MyRPA.Samples.DemoPlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- Phase 7 (ADR-0042): the order-report sample runs with the product plugins, loaded by the CLI like a user would. -->
    <ProjectReference Include="..\..\plugins\MyRPA.Files\MyRPA.Files.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\plugins\MyRPA.Http\MyRPA.Http.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\plugins\MyRPA.Spreadsheet\MyRPA.Spreadsheet.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\plugins\MyRPA.Browser.Playwright\MyRPA.Browser.Playwright.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- Phase 7.1 (ADR-0043): the invoice-intake sample. -->
    <ProjectReference Include="..\..\plugins\MyRPA.Email\MyRPA.Email.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\plugins\MyRPA.Documents\MyRPA.Documents.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\plugins\MyRPA.Database\MyRPA.Database.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\plugins\MyRPA.Sftp\MyRPA.Sftp.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\plugins\MyRPA.Scripting\MyRPA.Scripting.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test PDFs are written by hand (PdfPig belongs to the documents plugin only). -->
    <Compile Include="..\MyRPA.Documents.Tests\PdfFiles.cs" Link="PdfFiles.cs" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SamplePluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\samples\plugins\MyRPA.Samples.DemoPlugin\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FilesPluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Files\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HttpPluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Http\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SpreadsheetPluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Spreadsheet\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BrowserPluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Browser.Playwright\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EmailPluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Email\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DocumentsPluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Documents\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DatabasePluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Database\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SftpPluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Sftp\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ScriptingPluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Scripting\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

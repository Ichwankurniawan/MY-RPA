<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HTTP plugin tests (ADR-0042). The plugin is built first but never compiled against (ReferenceOutputAssembly=false):
    tests load it through the real plugin host, like the CLI. Every request goes to a local test server on localhost.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\MyRPA.Plugins\MyRPA.Plugins.csproj" />
    <ProjectReference Include="..\..\src\MyRPA.Runtime\MyRPA.Runtime.csproj" />
    <ProjectReference Include="..\..\plugins\MyRPA.Http\MyRPA.Http.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HttpPluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Http\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

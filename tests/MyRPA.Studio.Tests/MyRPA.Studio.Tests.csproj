<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The WPF Studio shell (ADR-0018): composition, command line, window smoke tests with rendered screenshots, and the
    architecture code rules on its compiled assembly (MyRPA.Architecture.Tests targets net10.0 and cannot reference it).
    Windows only.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Compiles everywhere (Linux CI proves it builds); runs only where WPF exists. -->
    <IsTestProject Condition="!$([MSBuild]::IsOSPlatform('Windows'))">false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MyRPA.Studio\MyRPA.Studio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same detectors the architecture tests use on every other src assembly. -->
    <Compile Include="..\MyRPA.Architecture.Tests\IlScanner.cs" Link="Architecture\IlScanner.cs" />
    <Compile Include="..\MyRPA.Architecture.Tests\CodeRuleDetectors.cs" Link="Architecture\CodeRuleDetectors.cs" />
  </ItemGroup>
</Project>

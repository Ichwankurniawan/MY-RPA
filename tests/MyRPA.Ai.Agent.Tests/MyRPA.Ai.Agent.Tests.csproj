<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The AI Agent (ADR-0048) through the real engine, plugin host and file resolver. The model is the scripted provider
    fixture; MCP servers are a fake stdio process and a fake HTTP endpoint. No model, network service or key is used.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\MyRPA.Plugins\MyRPA.Plugins.csproj" />
    <ProjectReference Include="..\..\src\MyRPA.Runtime\MyRPA.Runtime.csproj" />
    <ProjectReference Include="..\..\src\MyRPA.Storage\MyRPA.Storage.csproj" />
    <ProjectReference Include="..\..\src\MyRPA.Activities\MyRPA.Activities.csproj" />
    <ProjectReference Include="..\..\src\MyRPA.Ai.Contracts\MyRPA.Ai.Contracts.csproj" />
    <ProjectReference Include="..\..\plugins\MyRPA.Ai.Agent\MyRPA.Ai.Agent.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\fixtures\MyRPA.Tests.ScriptedAi\MyRPA.Tests.ScriptedAi.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\fixtures\MyRPA.Tests.FakeMcpServer\MyRPA.Tests.FakeMcpServer.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <PropertyGroup>
    <!-- CA1861: the scripted answers are small literal arrays built once per test. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentPluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Ai.Agent\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ScriptedAiDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\fixtures\MyRPA.Tests.ScriptedAi\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FakeMcpServer</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\fixtures\MyRPA.Tests.FakeMcpServer\bin\$(Configuration)\$(TargetFramework)\MyRPA.Tests.FakeMcpServer.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

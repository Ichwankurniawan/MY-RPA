<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Scripting plugin tests (ADR-0043). The plugin is built first but never compiled against (ReferenceOutputAssembly=false):
    tests load it through the real plugin host, like the CLI. Jint belongs to the plugin only. JavaScript tests always run;
    Python tests run with an interpreter on PATH or MYRPA_TEST_PYTHON.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\MyRPA.Plugins\MyRPA.Plugins.csproj" />
    <ProjectReference Include="..\..\src\MyRPA.Runtime\MyRPA.Runtime.csproj" />
    <ProjectReference Include="..\..\plugins\MyRPA.Scripting\MyRPA.Scripting.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ScriptingPluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Scripting\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

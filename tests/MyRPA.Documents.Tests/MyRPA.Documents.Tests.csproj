<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Documents plugin tests (ADR-0043). The plugin is built first but never compiled against (ReferenceOutputAssembly=false):
    tests load it through the real plugin host, like the CLI. PdfPig belongs to the plugin only, so test PDFs are written
    by hand (PdfFiles), including RC4 encryption for the password tests.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\MyRPA.Plugins\MyRPA.Plugins.csproj" />
    <ProjectReference Include="..\..\src\MyRPA.Runtime\MyRPA.Runtime.csproj" />
    <ProjectReference Include="..\..\plugins\MyRPA.Documents\MyRPA.Documents.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DocumentsPluginDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\plugins\MyRPA.Documents\bin\$(Configuration)\$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Sample plugin (ADR-0014). A plugin references only the Automation SDK (MyRPA.Sdk, which brings MyRPA.Core and
    MyRPA.Workflow) and optional Microsoft.Extensions.*.Abstractions. Those contract assemblies are provided by the
    host at run time, so they are referenced with Private=false / ExcludeAssets=runtime and not copied next to the
    plugin. The build output directory (bin/<Configuration>/net10.0) is a complete plugin directory:
    myrpa-plugin.json + MyRPA.Samples.DemoPlugin.dll + .deps.json.
  -->
  <PropertyGroup>
    <RootNamespace>MyRPA.Samples.DemoPlugin</RootNamespace>
    <Description>MyRPA sample plugin: Demo.Echo, Demo.GetField and the in-memory Demo.Text provider.</Description>
    <!-- Produces a .deps.json and copies private dependencies, as AssemblyLoadContext-based loading requires. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\MyRPA.Sdk\MyRPA.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Include="myrpa-plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- MyRPA.Core and MyRPA.Workflow arrive transitively through MyRPA.Sdk; they are host-provided contract assemblies too. -->
  <Target Name="ExcludeHostContractAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'MyRPA.Core' or '%(Filename)' == 'MyRPA.Workflow'" />
    </ItemGroup>
  </Target>
</Project>

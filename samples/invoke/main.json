{
  "schemaVersion": "1.0",
  "id": "invoke-main",
  "name": "Invoke a child workflow",
  "version": "1.0.0",
  "arguments": [
    { "name": "result", "direction": "Out", "type": "Int" }
  ],
  "root": {
    "id": "call-add",
    "type": "Core.InvokeWorkflow",
    "properties": {
      "workflow": "workflows/add.json",
      "arguments": { "a": 40, "b": "1 + 1" },
      "outputs": { "sum": "result" },
      "timeoutMilliseconds": 5000
    }
  }
}

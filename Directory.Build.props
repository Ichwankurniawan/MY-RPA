<Project>
  <!--
    Shared build settings for every project in the repository.
    Architecture rules (docs/architecture/overview.md) depend on these defaults:
    all Phase 1 projects target net10.0 and must not override TargetFramework.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <Version>0.1.0</Version>
    <Product>MyRPA</Product>
    <Authors>MyRPA contributors</Authors>
    <Copyright>MyRPA contributors</Copyright>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
